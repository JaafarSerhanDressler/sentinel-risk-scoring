@* Animated vertical bar chart for weekly throughput. *@
<div style="display:flex; align-items:flex-end; gap:12px; height:@(H)px; padding-top:8px;">
    @{
        var max = Data.Count == 0 ? 1 : Data.Max(d => d.Assessments);
    }
    @foreach (var p in Data)
    {
        var target = max == 0 ? 0 : (double)p.Assessments / max * (H - 28);
        <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:7px; height:100%; justify-content:flex-end;">
            <span style="font-size:11px; font-weight:700; color:var(--muted);">@p.Assessments</span>
            <div style="width:100%; max-width:34px; border-radius:7px 7px 3px 3px;
                        background:linear-gradient(180deg,#6366f1,#22d3ee);
                        height:@((_mounted ? target : 0).ToString("0.##"))px;
                        transition:height .9s var(--ease); box-shadow:0 6px 16px -6px var(--brand-glow);"></div>
            <span style="font-size:11px; color:var(--faint);">@p.Label</span>
        </div>
    }
</div>

@code {
    [Parameter] public List<ThroughputPoint> Data { get; set; } = new();
    [Parameter] public int H { get; set; } = 180;

    private bool _mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.Delay(100);
        _mounted = true;
        await InvokeAsync(StateHasChanged);
    }
}
