@page "/not-found"
@layout BlankLayout

<PageTitle>Not found · Sentinel</PageTitle>

<div style="min-height:100vh; display:grid; place-items:center; padding:24px;">
    <div class="card pad-lg center-col page-enter" style="max-width:420px; text-align:center; gap:14px;">
        <div class="brand-mark" style="width:54px; height:54px;"><Icon Name="shield" /></div>
        <h1 style="font-size:40px;">404</h1>
        <p class="muted" style="font-size:14px;">The page you are looking for doesn’t exist or has moved.</p>
        <a class="btn btn-primary" href=""><Icon Name="dashboard" /> Back to dashboard</a>
    </div>
</div>